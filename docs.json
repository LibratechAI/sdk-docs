{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Libra SDK",
  "colors": {
    "primary": "#1A1A1A",
    "light": "#FAFAFA",
    "dark": "#1A1A1A"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Fakt Pro",
      "weight": 700,
      "source": "/fonts/FaktTT-Bold.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Fakt Pro",
      "weight": 400,
      "source": "/fonts/FaktTT-Normal.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/assets/images/brand/libra-wk-pos.png",
    "dark": "/assets/images/brand/libra-wk-rev.png",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "Playground",
        "href": "https://sdk.staging.libratech.ai/playground.html"
      },
      {
        "label": "Libra docs",
        "href": "https://docs.libratech.ai"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor"
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "icon": "rocket",
        "pages": [
          "index",
          "getting-started/quickstart",
          "getting-started/how-it-works",
          "getting-started/playground"
        ]
      },
      {
        "group": "Integration guides",
        "icon": "plug",
        "pages": [
          "guides/installation",
          "guides/embedding",
          "guides/panel-and-placement",
          "guides/authentication",
          "guides/proxy-mode",
          "guides/locales",
          "guides/citations",
          "guides/document-suggestions",
          "guides/chat-handoff",
          "guides/security-headers",
          "guides/best-practices"
        ]
      },
      {
        "group": "Capabilities",
        "icon": "sparkles",
        "pages": [
          "capabilities/overview",
          "capabilities/chat",
          "capabilities/context-and-sources",
          "capabilities/plans-and-limits",
          "capabilities/products-and-sources"
        ]
      },
      {
        "group": "Reference",
        "icon": "book-open",
        "pages": [
          "reference/api",
          "reference/types"
        ]
      },
      {
        "group": "Resources",
        "icon": "history",
        "pages": [
          "changelog"
        ]
      }
    ]
  }
}
