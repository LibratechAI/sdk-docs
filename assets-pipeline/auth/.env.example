# Capture-account credentials for the SDK playground (staging only).
#
# SECURITY: use a dedicated "sdk-docs-capture" staging account, never a
# personal login. This file is gitignored — copy it to .env and fill it in
# locally / in your CI secret store. Never paste real values into a PR,
# issue, or chat.

SDK_PLAYGROUND_URL=https://sdk.staging.libratech.ai
CAPTURE_ACCOUNT_EMAIL=
CAPTURE_ACCOUNT_PASSWORD=
